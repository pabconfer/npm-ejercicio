# CARPETA 1: node_modules
# Contiene las dependencias instaladas del proyecto.
# No excluirla provocaría un repositorio muy pesado,
# subidas lentas y posibles conflictos entre dependencias.
node_modules 

# CARPETA 2: dist
# Contiene los archivos generados durante la compilación.
# No excluirla provocaría archivos innecesarios,
# duplicados y posibles conflictos al recompilar.
dist

dist-ssr
*.local

